# Copy to .env and change every secret before going live.

WEB_PORT=3000

# LAN address / host name of the server (HTTPS certificate so the camera works on kiosk PCs)
SERVER_IP=192.168.55.88
SERVER_NAME=pms-server

POSTGRES_DB=scanid
POSTGRES_USER=scanid
POSTGRES_PASSWORD=change-this-db-password

# Long random strings (e.g. 48+ chars). QR_SECRET signs the QR printed on every card:
# changing it later makes ALL printed QR codes invalid (card reader & ID number still work).
JWT_SECRET=change-this-to-a-long-random-string
QR_SECRET=change-this-to-another-long-random-string

# First admin account (created only when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Set true when served over HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12

APP_TZ=Asia/Bangkok
# Scan windows (HH:MM). Scans outside both windows are rejected ("Outside scan hours").
# The work day starts at CHECKIN_START, so a check-out before 04:00 counts for the previous day.
CHECKIN_START=04:30
CHECKIN_END=16:30
CHECKOUT_START=16:35
CHECKOUT_END=04:00
# Second scan within this many seconds = duplicate (not a check-out)
SCAN_MIN_GAP_SECONDS=60
# Allow check-in with the ID number alone (typed or old QR). Set false to require card number / signed QR.
ALLOW_ID_ONLY_SCAN=true
LOG_RETENTION_DAYS=90
DB_POOL_MAX=20
